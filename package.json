{
  "name": "website",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && wrangler types worker/worker-configuration.d.ts > /dev/null && tsc -p worker && tsc -p worker/tsconfig.test.json",
    "test": "bun test",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,astro}\"",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,astro}\" --fix",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "4.162.0"
  }
}
