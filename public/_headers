/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </sitemap-index.xml>; rel="sitemap"; type="application/xml"

# Pages answer `Accept: text/markdown` with their Markdown twin (worker/negotiate.ts), so caches must
# key both variants on Accept. Covers the HTML page and its index.md.
/
  Vary: Accept
/index.md
  Vary: Accept
/work/*
  Vary: Accept
/projects/*
  Vary: Accept
/speaking/*
  Vary: Accept

# Assets serve .txt and .md without a charset, and both carry em dashes and arrows.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8
/*.md
  Content-Type: text/markdown; charset=utf-8

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
