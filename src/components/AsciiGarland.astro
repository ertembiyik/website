---
import sharp from "sharp";
import artwork from "../assets/garland.svg?raw";

/**
 * The footer garland: the illustration in src/assets/garland.svg turned into coloured characters at
 * build time. Every 8×13 px cell (the 0.6 × 0.975 em proportions of a Geist Mono line) becomes one
 * glyph: an outline stroke on a thin edge, otherwise a density character from coverage and light. Its
 * colour is the cell's average, snapped to a k-means palette of `tones` colours. On hover or touch the
 * script below redraws it on a canvas and lets the flowers sway in a spring-driven wind.
 */
interface Props {
  cols?: number;
  rows?: number;
  tones?: number;
}

const { cols = 240, rows = 44, tones = 48 } = Astro.props;

type RGB = [number, number, number];

const cellW = 8;
const cellH = 13;
const ramp = " .:-+*ox%#@";
const luminance = ([r, g, b]: RGB) => (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;

const { data } = await sharp(Buffer.from(artwork), { density: 144 })
  .resize(cols * cellW, rows * cellH, { fit: "fill" })
  .ensureAlpha()
  .raw()
  .toBuffer({ resolveWithObject: true });

const sampleCell = (col: number, row: number) => {
  let alpha = 0;
  const sum: RGB = [0, 0, 0];
  const quadrants = [0, 0, 0, 0];
  for (let y = 0; y < cellH; y++) {
    for (let x = 0; x < cellW; x++) {
      const i = ((row * cellH + y) * cols * cellW + col * cellW + x) * 4;
      const a = (data[i + 3] ?? 0) / 255;
      alpha += a;
      sum[0] += (data[i] ?? 0) * a;
      sum[1] += (data[i + 1] ?? 0) * a;
      sum[2] += (data[i + 2] ?? 0) * a;
      quadrants[(y < cellH / 2 ? 0 : 2) + (x < cellW / 2 ? 0 : 1)]! += a;
    }
  }
  const area = cellW * cellH;
  const coverage = alpha / area;
  if (coverage < 0.1) return undefined;

  const colour: RGB = [sum[0] / alpha, sum[1] / alpha, sum[2] / alpha];
  const [tl, tr, bl, br] = quadrants.map((value) => value / (area / 4)) as [number, number, number, number];
  const gx = (tr + br - tl - bl) / 2;
  const gy = (bl + br - tl - tr) / 2;
  let char: string;
  if (coverage < 0.42 && Math.hypot(gx, gy) > 0.5) {
    const sector = Math.round(((Math.atan2(gy, gx) + Math.PI) / Math.PI) * 4) % 8;
    char = sector % 4 === 0 ? "|" : sector % 4 === 2 ? (gy > 0 ? "_" : "-") : sector === 1 || sector === 5 ? "/" : "\\";
  } else {
    const density = Math.min(1, coverage * (0.18 + 1.05 * luminance(colour)));
    char = ramp[Math.max(1, Math.min(ramp.length - 1, Math.round(density * (ramp.length - 1))))]!;
  }
  // Lift the darkest greens so they still read on the page background.
  const light = luminance(colour);
  const lift = light < 0.2 ? 0.2 / Math.max(0.02, light) : 1;
  return { char, colour: colour.map((value) => Math.min(255, value * lift)) as RGB };
};

const cells = Array.from({ length: rows }, (_, row) => Array.from({ length: cols }, (_, col) => sampleCell(col, row)));

// A deterministic k-means palette over every drawn cell, weighted by how the eye sees each channel.
const drawn = cells.flat().flatMap((cell) => (cell ? [cell.colour] : []));
const distance = (a: RGB, b: RGB) => (a[0] - b[0]) ** 2 * 0.3 + (a[1] - b[1]) ** 2 * 0.59 + (a[2] - b[2]) ** 2 * 0.11;
let palette: RGB[] = Array.from({ length: tones }, (_, i) => drawn[Math.floor((i / tones) * drawn.length)] ?? [0, 0, 0]);
const nearest = (colour: RGB) => {
  let best = 0;
  palette.forEach((tone, i) => {
    if (distance(colour, tone) < distance(colour, palette[best]!)) best = i;
  });
  return best;
};
for (let pass = 0; pass < 12; pass++) {
  const sums = palette.map(() => [0, 0, 0, 0]);
  for (const colour of drawn) {
    const sum = sums[nearest(colour)]!;
    sum[0]! += colour[0];
    sum[1]! += colour[1];
    sum[2]! += colour[2];
    sum[3]! += 1;
  }
  palette = palette.map((tone, i) => {
    const [r, g, b, n] = sums[i]!;
    return n ? [r! / n, g! / n, b! / n] : tone;
  });
}

const hex = (colour: RGB) => `#${colour.map((value) => Math.round(value).toString(16).padStart(2, "0")).join("")}`;
const css = palette.map((tone, i) => `.garland .g${i}{color:${hex(tone)}}`).join("");

const art = cells
  .map((line) => {
    let out = "";
    let open = -1;
    for (const cell of line) {
      const tone = cell ? nearest(cell.colour) : -1;
      if (tone !== open && open >= 0) out += "</span>";
      if (tone !== open && tone >= 0) out += `<span class="g${tone}">`;
      open = tone;
      out += cell ? cell.char : " ";
    }
    if (open >= 0) out += "</span>";
    return out.trimEnd();
  })
  .join("\n");
---

<div class="garland" aria-hidden="true" data-garland>
  <div class="garland-art">
    <pre style={{ "--cols": cols }} set:html={art} />
  </div>
</div>
<style is:inline set:html={css} />

<script>
  type Glyph = { char: string; col: number; row: number };

  // Column springs range between these periods, changing slowly across the bed: a bloom's columns
  // share a period and sway as one, while flowers further apart fall out of phase.
  const periods = [0.95, 1.3];
  const bounce = 0.3;
  const coupling = 40;
  const reach = 18;
  const maxBend = 3.5;
  const pad = 6;

  function bindGarland(signal: AbortSignal) {
    const host = document.querySelector<HTMLElement>("[data-garland]");
    const box = host?.querySelector<HTMLElement>(".garland-art");
    const pre = box?.querySelector("pre");
    if (!host || !box || !pre || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Read the glyphs back out of the static art, grouped by colour.
    const groups = new Map<string, Glyph[]>();
    const toneOf = new Map<string, string>();
    let row = 0;
    let col = 0;
    let cols = 0;
    for (const node of Array.from(pre.childNodes)) {
      const text = node.textContent ?? "";
      let colour: string | undefined;
      if (node instanceof HTMLElement) {
        colour = toneOf.get(node.className) ?? getComputedStyle(node).color;
        toneOf.set(node.className, colour);
      }
      for (const char of text) {
        if (char === "\n") {
          row += 1;
          col = 0;
          continue;
        }
        if (colour && char !== " ") {
          const list = groups.get(colour) ?? [];
          list.push({ char, col, row });
          groups.set(colour, list);
        }
        col += 1;
        cols = Math.max(cols, col);
      }
    }
    const rows = row + 1;

    const canvas = document.createElement("canvas");
    const context = canvas.getContext("2d");
    if (!context) return;
    box.append(canvas);

    const bend = new Float32Array(cols);
    const velocity = new Float32Array(cols);
    const omega = Float32Array.from({ length: cols }, (_, i) => {
      const period = periods[0]! + (periods[1]! - periods[0]!) * (0.5 + 0.5 * Math.sin(i * 0.07));
      return (2 * Math.PI) / period;
    });
    // Rooted at the ground: the top of the art sways the most.
    const sway = Float32Array.from({ length: rows }, (_, r) => Math.pow(1 - r / rows, 1.6));

    let metrics = { advance: 0, line: 0, baseline: 0 };
    const measure = () => {
      const style = getComputedStyle(pre);
      const size = parseFloat(style.fontSize);
      const ratio = devicePixelRatio || 1;
      const font = `700 ${size}px ${style.fontFamily}`;
      context.font = font;
      const probe = context.measureText("M");
      const line = size * 0.975;
      const baseline = (line - probe.fontBoundingBoxAscent - probe.fontBoundingBoxDescent) / 2 + probe.fontBoundingBoxAscent;
      metrics = { advance: probe.width, line, baseline };
      const width = (cols + pad * 2) * probe.width;
      const height = rows * line;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.cssText = `left:${-pad * probe.width}px;top:0;width:${width}px;height:${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.font = font;
      context.textBaseline = "alphabetic";
    };

    const draw = () => {
      const { advance, line, baseline } = metrics;
      context.clearRect(0, 0, canvas.width, canvas.height);
      // Skip columns the crop hides on narrow screens.
      const hostRect = host.getBoundingClientRect();
      const boxRect = box.getBoundingClientRect();
      const first = Math.floor((hostRect.left - boxRect.left) / advance) - pad;
      const last = Math.ceil((hostRect.right - boxRect.left) / advance) + pad;
      for (const [colour, glyphs] of groups) {
        context.fillStyle = colour;
        for (const { char, col, row } of glyphs) {
          if (col < first || col > last) continue;
          context.fillText(char, (col + pad + bend[col]! * sway[row]!) * advance, row * line + baseline);
        }
      }
    };

    let breeze = 0;
    let inside = false;
    let frame = 0;
    let lastTime = 0;
    let pointer = { x: 0, time: 0 };

    const tick = (now: number) => {
      frame = 0;
      const dt = Math.min((now - lastTime) / 1000, 1 / 30);
      lastTime = now;
      breeze += ((inside ? 1 : 0) - breeze) * (1 - Math.exp(-dt * 3));
      const t = now / 1000;
      let moving = inside || breeze > 0.01;
      for (let i = 0; i < cols; i++) {
        const w = omega[i]!;
        const wind = breeze * 0.9 * Math.sin(t * 1.7 + i * 0.09) * Math.sin(t * 0.6 + i * 0.023);
        const left = bend[i - 1] ?? bend[i]!;
        const right = bend[i + 1] ?? bend[i]!;
        const force =
          -w * w * (bend[i]! - wind) - 2 * (1 - bounce) * w * velocity[i]! + coupling * (left + right - 2 * bend[i]!);
        velocity[i]! += force * dt;
        bend[i] = Math.max(-maxBend, Math.min(maxBend, bend[i]! + velocity[i]! * dt));
        if (Math.abs(bend[i]!) > 0.002 || Math.abs(velocity[i]!) > 0.002) moving = true;
      }
      if (!moving) {
        bend.fill(0);
        velocity.fill(0);
      }
      draw();
      if (moving) frame = requestAnimationFrame(tick);
    };
    const wake = () => {
      if (frame) return;
      lastTime = performance.now();
      frame = requestAnimationFrame(tick);
    };

    // Columns near `clientX` pick up `speed` (cells per second), fading with distance.
    const push = (clientX: number, speed: (offset: number) => number) => {
      const centre = (clientX - box.getBoundingClientRect().left) / metrics.advance;
      for (let i = Math.max(0, Math.floor(centre - reach)); i < Math.min(cols, centre + reach); i++) {
        const falloff = 1 - Math.abs(i - centre) / reach;
        velocity[i]! += speed(i - centre) * falloff * falloff;
      }
      wake();
    };

    host.addEventListener("pointerenter", () => {
      inside = true;
      wake();
    });
    host.addEventListener("pointerleave", () => {
      inside = false;
    });
    host.addEventListener("pointermove", (event) => {
      const elapsed = Math.max(8, event.timeStamp - pointer.time);
      const speed = ((event.clientX - pointer.x) / metrics.advance / elapsed) * 1000;
      if (pointer.time) push(event.clientX, () => Math.max(-60, Math.min(60, speed)) * 0.35);
      pointer = { x: event.clientX, time: event.timeStamp };
    });
    // A tap parts the flowers either side of the finger.
    host.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse") push(event.clientX, (offset) => Math.sign(offset) * 9);
    });

    const resize = new ResizeObserver(() => {
      measure();
      draw();
    });
    resize.observe(box);
    signal.addEventListener("abort", () => {
      resize.disconnect();
      cancelAnimationFrame(frame);
    });

    measure();
    draw();
    host.dataset.live = "";
  }

  let binding: AbortController | undefined;
  document.addEventListener("astro:page-load", async () => {
    binding?.abort();
    binding = new AbortController();
    const { signal } = binding;
    await document.fonts.ready;
    if (!signal.aborted) bindGarland(signal);
  });
</script>
