---
import type { ConnectLink } from "../data/site";

/** A monochrome squircle tile linking out, with its name in a tooltip. Takes a glyph path or a short wordmark. */
type Props = ConnectLink & { size: number };

const { label, spoken = label, size, href, scale = 1 } = Astro.props;
// Stroked glyphs (Heroicons) are drawn at a weight that matches the filled brand marks.
const glyph = "glyph" in Astro.props ? { d: Astro.props.glyph, stroke: Astro.props.stroke === true } : undefined;
const text = "text" in Astro.props ? Astro.props.text : undefined;
const external = href.startsWith("http");
---

<a
  class="tile"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  aria-label={spoken}
  title={label}
>
  <span class="squircle squircle-glyph" style={{ "--size": `${size}px`, "--glyph-scale": scale }} aria-hidden="true">
    {
      glyph ? (
        <svg viewBox="0 0 24 24">
          {glyph.stroke ? (
            <path d={glyph.d} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          ) : (
            <path d={glyph.d} fill="currentColor" />
          )}
        </svg>
      ) : (
        text
      )
    }
  </span>
  <span class="tile-name" aria-hidden="true">{label}</span>
</a>
