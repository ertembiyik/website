---
import "../styles/globals.css";
import { ClientRouter } from "astro:transitions";
import interUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import geistMonoUrl from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import { links, profile } from "../data/site";

interface Props {
  title: string;
  description?: string;
  home?: boolean;
}

const { title, description = profile.description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
const pageTitle = home ? title : `${title} — ${profile.name}`;

// Every page except the 404 has a Markdown twin for agents (see src/data/markdown.ts).
const isNotFound = Astro.url.pathname.replace(/\/$/, "") === "/404";
const markdownHref = isNotFound ? undefined : `${Astro.url.pathname.replace(/\/?$/, "/")}index.md`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  jobTitle: "Founding engineer",
  worksFor: { "@type": "Organization", name: "Pool", url: "https://pool.day" },
  sameAs: [links.x, links.github, links.linkedin, links.telegram],
};

// Inlined so the fonts start downloading before the stylesheet arrives. font-display: block (with the
// preloads below) means a new document never paints fallback text and then swaps mid view transition.
const fontFaces = `
@font-face{font-family:"Inter Variable";font-style:normal;font-display:block;font-weight:100 900;src:url("${interUrl}") format("woff2")}
@font-face{font-family:"Geist Mono Variable";font-style:normal;font-display:block;font-weight:100 900;src:url("${geistMonoUrl}") format("woff2")}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ertembiyik" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />}

    <style is:inline set:html={fontFaces}></style>
    {/* Same-document navigation: the next page is fetched and swapped in place, so the view
        transition runs without a reload. Rows morph into detail headings via matching names. */}
    <ClientRouter />

    {/* Intro animation plays once per session. Decided before first paint to avoid a flash. */}
    <script is:inline>
      try {
        if (!sessionStorage.getItem("intro")) {
          sessionStorage.setItem("intro", "1");
          document.documentElement.dataset.intro = "";
        }
      } catch {
        /* sessionStorage unavailable: play nothing rather than flash. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />

    <script>
      // The index can link to one entry from several places (the intro sentence and its row).
      // View-transition names must be unique per page, so they are assigned at navigation time to
      // the link the reader actually used: set when leaving the index, and restored on the same
      // link when coming back. Detail pages carry their names statically.
      const KEY = "morph-scope";
      let cameFrom = "";

      function nameOnly(link: Element | null) {
        for (const el of document.querySelectorAll<HTMLElement>("[data-morph]")) {
          el.style.viewTransitionName = link?.contains(el) ? (el.dataset.morph ?? "") : "";
        }
      }

      document.addEventListener("astro:before-preparation", (event) => {
        cameFrom = event.from.pathname.replace(/\/$/, "");
        const link = event.sourceElement?.closest("a[data-morph-scope]");
        if (!(link instanceof HTMLAnchorElement)) return;
        sessionStorage.setItem(KEY, `${link.dataset.morphScope}:${link.getAttribute("href")}`);
        nameOnly(link);
      });

      document.addEventListener("astro:after-swap", () => {
        const links = document.querySelectorAll<HTMLAnchorElement>(`a[data-morph-scope][href="${cameFrom}"]`);
        if (links.length === 0) return;
        const saved = sessionStorage.getItem(KEY);
        const used = Array.from(links).find((link) => `${link.dataset.morphScope}:${cameFrom}` === saved);
        nameOnly(used ?? links[links.length - 1]);
      });
    </script>
    {/* Agentation feedback toolbar, dev server only. The module is never referenced by production builds. */}
    {import.meta.env.DEV && <script is:inline type="module" src="/src/dev/agentation.ts"></script>}
  </body>
</html>
