---
import "../styles/globals.css";
import { ClientRouter } from "astro:transitions";
import interUrl from "../assets/fonts/inter-latin-wght-400-700.woff2?url";
import geistMonoUrl from "../assets/fonts/geist-mono-latin-wght-400-700.woff2?url";
import ogCardUrl from "../assets/og-card.png?url";
import { profile } from "../data/site";

interface Props {
  title: string;
  description?: string;
  home?: boolean;
  /** schema.org data for the page, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  /** The 404 page: no canonical URL, no Markdown twin, not indexed. */
  notFound?: boolean;
}

const { title, description = profile.description, home = false, jsonLd, notFound = false } = Astro.props;
const canonical = notFound ? undefined : new URL(Astro.url.pathname, Astro.site);
// Hashed, so a new card reaches link previews that cached the old one.
const socialImage = new URL(ogCardUrl, Astro.site);
const pageTitle = home ? title : `${title} · ${profile.name}`;

// Every page except the 404 has a Markdown twin for agents (see src/data/markdown.ts).
const markdownHref = notFound ? undefined : `${Astro.url.pathname.replace(/\/?$/, "/")}index.md`;

// Inlined so the fonts start downloading before the stylesheet arrives. font-display: block (with the
// preloads below) means a new document never paints fallback text and then swaps mid view transition.
const fontFaces = `
@font-face{font-family:"Inter Variable";font-style:normal;font-display:block;font-weight:400 700;src:url("${interUrl}") format("woff2")}
@font-face{font-family:"Geist Mono Variable";font-style:normal;font-display:block;font-weight:400 700;src:url("${geistMonoUrl}") format("woff2")}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    {/* Mono is below the fold (garland, tooltips), so it gives way to Inter and the first paint. */}
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin fetchpriority="low" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ertembiyik" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <style is:inline set:html={fontFaces}></style>
    {/* Same-document navigation: the next page is fetched and swapped in place, so the view
        transition runs without a reload. Rows morph into detail headings via matching names. */}
    <ClientRouter />

    {/* Intro animation plays once per session. Decided before first paint to avoid a flash. */}
    <script is:inline>
      try {
        if (!sessionStorage.getItem("intro")) {
          sessionStorage.setItem("intro", "1");
          document.documentElement.dataset.intro = "";
        }
      } catch {
        /* sessionStorage unavailable: play nothing rather than flash. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />

    <script>
      import "../scripts/navigation";
    </script>
  </body>
</html>
