---
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import AppIcon from "../../components/AppIcon.astro";
import Layout from "../../layouts/Layout.astro";
import portrait from "../../assets/me/01-ertem.jpg";
import { entryPaths, metaLine } from "../../data/entries";
import { profile } from "../../data/site";

export const getStaticPaths = entryPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = metaLine(entry);
const [primary, ...secondary] = entry.data.links;
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <main id="content" class="frame detail">
    <nav class="detail-nav" aria-label="Back">
      <a class="back" href="/" data-back>
        <span class="back-arrow" aria-hidden="true">←</span>
        <AppIcon src={portrait} size={20} loading="eager" />
        {profile.name}
      </a>
    </nav>

    <header class="detail-hero">
      {
        entry.data.icon && (
          <AppIcon
            src={entry.data.icon}
            size={56}
            loading="eager"
            transitionName={`icon-${entry.id}`}
          />
        )
      }
      <div class="detail-heading">
        <h1 class="morph" style={{ viewTransitionName: `title-${entry.id}` }}>{entry.data.title}</h1>
        <p class="detail-meta">{meta}</p>
      </div>
      <div class="chips">
        <a class="pill" href={primary.url} target="_blank" rel="noopener">
          {primary.label}
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        {
          secondary.map((link) => (
            <a class="pill pill-ghost" href={link.url} target="_blank" rel="noopener">
              {link.label}
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </header>

    {
      entry.data.screens.length > 0 && (
        <section class="phones" aria-label={`${entry.data.title} screenshots`}>
          <ul class="phones-track">
            {entry.data.screens.map((screen, index) => (
              <li class="phone">
                <Image
                  src={screen}
                  alt={`${entry.data.title} screenshot ${index + 1}`}
                  width={220}
                  height={476}
                  densities={[1, 2, 3]}
                  loading={index < 3 ? "eager" : "lazy"}
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <article class="prose">
      <Content />
    </article>
  </main>
</Layout>

