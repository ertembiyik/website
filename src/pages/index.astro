---
import AppIcon from "../components/AppIcon.astro";
import AsciiGarland from "../components/AsciiGarland.astro";
import IconTile from "../components/IconTile.astro";
import Layout from "../layouts/Layout.astro";
import PhotoStack from "../components/PhotoStack.astro";
import { entryUrl, introParagraphs, loadEntries, workEntry } from "../data/entries";
import { connect, current, links, profile, writing } from "../data/site";

// "Feb 2026 – now" → "2026 – now"; "Aug 2022 – Nov 2025" → "2022 – 2025"; "Feb 2022 – Jul 2022" → "2022".
// Full periods live on detail pages.
const years = (period: string) => {
  const parts = period.split(/\s*[–-]\s*/).map((part) => part.match(/\d{4}/)?.[0] ?? part);
  return [...new Set(parts)].join(" – ");
};

const [{ work, projects, speaking }, intro, job] = await Promise.all([
  loadEntries(),
  introParagraphs(),
  workEntry(current.work),
]);

// Writing and talks share one list, newest first. Talks are pages here; writing lives elsewhere.
const notes = [
  ...writing.map(({ title, year, href }) => ({ title, year, href, talk: false })),
  ...speaking.map((talk) => ({ title: talk.data.title, year: talk.data.year, href: entryUrl(talk), talk: true })),
].sort((a, b) => b.year.localeCompare(a.year));

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  jobTitle: job.data.role,
  worksFor: { "@type": "Organization", name: job.data.title, url: job.data.links[0].url },
  sameAs: [links.x, links.github, links.linkedin, links.telegram],
};
---

<Layout title={profile.name} home jsonLd={person}>
  <main id="content" class="frame home">
    <header class="hero reveal" style="--i: 0">
      <PhotoStack width={96} height={120} />
      <h1>{profile.name}</h1>
      <div class="hero-copy">
        {
          intro.map((paragraph) => (
            <p>
              {paragraph.map((part) =>
                typeof part === "string" ? (
                  part
                ) : (
                  <a class="inline-app" href={entryUrl(part)} data-morph-scope="intro">
                    {part.data.icon && <AppIcon src={part.data.icon} size={18} loading="eager" morph={`icon-${part.id}`} />}
                    <span class="morph" data-morph={`title-${part.id}`}>{part.data.title}</span>
                  </a>
                ),
              )}
            </p>
          ))
        }
      </div>
    </header>

    <section class="section reveal" id="work" style="--i: 1" aria-labelledby="work-label">
      <h2 class="section-title" id="work-label">Experience</h2>
      <ol class="rows">
        {
          work.map((item) => (
            <li>
              <a class="row row-work" href={entryUrl(item)} data-morph-scope="row">
                <span class="row-body">
                  <span class="row-title">
                    {item.data.role} at{" "}
                    {item.data.icon && (
                      <AppIcon src={item.data.icon} size={18} morph={`icon-${item.id}`} />
                    )}
                    <span class="morph" data-morph={`title-${item.id}`}>{item.data.title}</span>
                  </span>
                  <span class="row-summary">{item.data.summary}</span>
                </span>
                <span class="row-date">{years(item.data.period)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section reveal" id="projects" style="--i: 2" aria-labelledby="projects-label">
      <h2 class="section-title" id="projects-label">Side projects</h2>
      <ol class="rows">
        {
          projects.map((project) => (
            <li>
              <a class="row row-project" href={entryUrl(project)} data-morph-scope="row">
                <AppIcon src={project.data.icon} size={40} morph={`icon-${project.id}`} />
                <span class="row-body">
                  <span class="row-title">
                    <span class="morph" data-morph={`title-${project.id}`}>{project.data.title}</span>
                  </span>
                  <span class="row-summary">{project.data.summary}</span>
                </span>
                <span class="row-date">{years(project.data.year)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section reveal" id="writing" style="--i: 3" aria-labelledby="writing-label">
      <h2 class="section-title" id="writing-label">Writing &amp; talks</h2>
      <ol class="rows rows-compact">
        {
          notes.map((note) => (
            <li>
              <a
                class="row row-note"
                href={note.href}
                target={note.talk ? undefined : "_blank"}
                rel={note.talk ? undefined : "noopener"}
              >
                <span class="row-title">{note.title}</span>
                <span class="row-end">
                  {note.talk && <span class="tag">talk</span>}
                  <span class="row-date">{note.year}</span>
                  <span class:list={["arrow", { "arrow-internal": note.talk }]} aria-hidden="true">
                    {note.talk ? "→" : "↗"}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section reveal" id="contact" style="--i: 4" aria-labelledby="contact-label">
      <h2 class="section-title" id="contact-label">Connect</h2>
      <ul class="tiles" aria-label="Ways to reach me">
        {connect.map((item) => (
          <li>
            <IconTile {...item} size={40} />
          </li>
        ))}
      </ul>
    </section>

    <AsciiGarland />

    <footer class="site-footer reveal" style="--i: 5">
      <p class="label">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <a href={links.source} target="_blank" rel="noopener">Source</a>
      </p>
    </footer>
  </main>
</Layout>

